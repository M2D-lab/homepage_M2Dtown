---
// トップ: 一本の巨大なナノワイヤの塔（3D ジオラマ）の上に文章を重ねる。テーマは黄 / 黒を切替。
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { fmtDate, isoDate } from '../lib/date';
import { ClientRouter } from 'astro:transitions';
import SiteChrome from '../components/SiteChrome.astro';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 5);   // タウンビューの見出しの下に最新 5 件
const publications = await getCollection('publications');
const equipment = await getCollection('equipment');
const members = await getCollection('members');
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
const pageTitle = site.labName + '｜' + site.labNameAlt + ' - ' + site.universityEn;
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('九州大学 伊都キャンパス ウエスト4号館');
// 模型上の目印（位置は diorama.js の HOTSPOTS と対応）
const spots = [
  { key: 'message', en: 'Message', label: 'メッセージ', href: withBase('/message'), desc: '研究室からのメッセージ。「誰もが簡単に、小さなモノづくりを。」目指していること、取り組み、問い合わせ先。' },
  { key: 'news', en: 'News', label: 'お知らせ', href: withBase('/news'), desc: '研究室からのお知らせ。' },
  { key: 'about', en: 'About', label: '研究室概要', href: withBase('/about'), desc: site.foundedText + '。固体中の原子拡散を駆使した、原子・ナノスケールのモノづくりに挑む研究室です。' },
  { key: 'research', en: 'Research', label: '研究テーマ', href: withBase('/research'), desc: research.length + ' つのテーマ。ナノワイヤ創製、Nano Additive Manufacturing、電子と欠陥、結晶組織デザイン。' },
  { key: 'members', en: 'Members', label: 'メンバー', href: withBase('/members'), desc: '教員・学生 ' + members.filter((m) => m.data.group !== 'alumni').length + ' 名の小さな研究室。メンバーを募集しています。' },
  { key: 'publications', en: 'Publications', label: '業績', href: withBase('/publications'), desc: '査読付き論文 ' + publications.length + ' 件を掲載（2024 年以降分。順次追加）。' },
  { key: 'equipment', en: 'Apparatus', label: '装置・設備', href: withBase('/equipment'), desc: '成膜・焼結から電子顕微鏡その場観察まで、' + equipment.length + ' 点の装置。' },
  { key: 'voices', en: 'Voices', label: '学生の声', href: withBase('/voices'), desc: '在学生から見た研究室の様子。' },
  { key: 'access', en: 'Access', label: 'アクセス', href: withBase('/access'), desc: '伊都キャンパス ウエスト4号館 428・414・401 室。' },
  { key: 'contact', en: 'Contact', label: 'お問い合わせ', href: withBase('/contact'), desc: '学生の方・企業の方・一般の方、それぞれへの案内と問い合わせフォーム。' },
];
---
<!doctype html>
<html lang="ja" data-theme="yellow">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={withBase('/style.css')} />
    <script is:inline>
      // テーマの初期化（描画前に反映して、ちらつきを防ぐ）
      try { var th = localStorage.getItem('m2d-theme'); if (['yellow', 'navy', 'green', 'black'].indexOf(th) >= 0) document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
    <ClientRouter />
  </head>
  <body>
    <canvas id="diorama" data-base={import.meta.env.BASE_URL} aria-label="大きな一本の木を中心にした町の 3D 模型"></canvas>
    <noscript><div class="nojs"><p>3D 模型の表示には JavaScript が必要です。</p></div></noscript>
    <svg class="leader" id="leader" aria-hidden="true"><path d="" /></svg>   <!-- 目印と左の説明を結ぶ点線 -->
    <canvas id="weather-fx" class="weather-fx" aria-hidden="true"></canvas>   <!-- 画面全体の季節の演出（桜・紅葉・雪。夏は無し） -->
    <div id="trail" aria-hidden="true"></div>   <!-- ランニング人形が土台の外へ出ると、ここに足跡が下から上へ付いて消える -->
    <div id="markers" aria-label="模型上のリンク">
      {spots.map((sp) => <a class="marker" data-spot={sp.key} href={sp.href}><i></i><span>{sp.label}</span></a>)}
    </div>


    <SiteChrome />

    <div class="content">
      <!-- タウンビュー: 模型が中央寄り（やや右）に来て、ゆっくり自転。左に M2D TOWN -->
      <section class="model-stage" id="town" aria-label="タウンビュー">
        <div class="town-name">
          <p class="org-top">九州大学大学院 工学研究院 機械工学部門</p>
          <p class="lab-name">材料創製力学研究室｜木村研究室</p>
          <p class="label">Mechanics for Material Design (M2D) Lab | KIMURA Laboratory</p>
          <p class="org">Department of Mechanical Engineering, Kyushu University</p>
        </div>
        <div class="town-title" aria-hidden="true"><span class="en">Town view</span>M2D<br />TOWN</div>
        <div class="spot-panel" aria-live="polite">
          {spots.map((sp) => (
            <div class="spot-info" data-for={sp.key}>
              <span class="en">{sp.en}</span><h3>{sp.label}</h3>
              {sp.key !== 'news' && <p>{sp.desc}</p>}
              {sp.key === 'news' && news.length > 0 && (   /* お知らせだけは説明文を置かず、直近 5 件を全件表示と同じ書式で */
                <ul class="news-list spot-news">{news.map((n) => <li class="news-row"><time datetime={isoDate(n.data.date)}>{fmtDate(n.data.date)}</time>　<span class="news-title">{n.data.title}</span></li>)}</ul>
              )}
            </div>
          ))}
        </div>
      </section>

      <footer class="footer wrap">&copy; {new Date().getFullYear()} {site.labNameEn} / {site.universityEn}</footer>
    </div>

    <script>
      import { createDiorama, seasonForDate } from '../scripts/diorama.js';
      import { createWeatherFx } from '../scripts/weatherfx.js';
      let d = null, fx = null;
      const current = () => document.documentElement.dataset.theme || 'yellow';
      function init() {
        const canvas = document.getElementById('diorama');
        if (!canvas || canvas.dataset.ready) return;
        canvas.dataset.ready = '1';
        const SEASONS = ['spring', 'summer', 'autumn', 'winter'];
        let sv = null; try { sv = localStorage.getItem('m2d-season'); } catch (e) {}
        const fxc = document.getElementById('weather-fx');
        if (fxc && !fxc.dataset.ready) { fxc.dataset.ready = '1'; fx = createWeatherFx(fxc, SEASONS.includes(sv) ? sv : seasonForDate()); }
        // 2026-11-21: 最初のムービー（看板イントロ）は廃止し、最初からタウンビューを出す（戻すときは intro: true を渡す。演出のコードは diorama.js に残してある）
        try { d = createDiorama(canvas, { themeName: current(), seasonName: SEASONS.includes(sv) ? sv : undefined, base: canvas.dataset.base || '/', intro: false }); window.__d = d; }
        catch (e) { console.warn('WebGL を初期化できません', e); canvas.style.display = 'none'; }
      }
      document.addEventListener('m2d:theme', (e) => { if (d) d.applyTheme(e.detail); });
      document.addEventListener('m2d:season', (e) => { if (d) d.applySeason(e.detail); if (fx) fx.setSeason(e.detail); });
      // 目印、または右上のナビの項目名にカーソルを合わせると、左に説明を出し、目印まで点線を結ぶ（トップだけ。ほかのページには目印が無いので何もしない）
      const markerOf = (key) => document.querySelector('.marker[data-spot="' + key + '"]');
      const hoverKey = (t) => { const el = t instanceof Element ? t.closest('.marker, .site-nav a[data-nav]') : null; return el ? { el, key: el.dataset.spot || el.dataset.nav } : null; };
      document.addEventListener('pointerover', (e) => {
        const h = hoverKey(e.target); if (!h || !markerOf(h.key)) return;
        document.querySelectorAll('.marker.hover').forEach((x) => x.classList.remove('hover'));
        document.querySelectorAll('.spot-info.on').forEach((x) => x.classList.remove('on'));
        markerOf(h.key).classList.add('hover');
        const info = document.querySelector('.spot-info[data-for="' + h.key + '"]'); if (info) info.classList.add('on');
      });
      document.addEventListener('pointerout', (e) => {
        const h = hoverKey(e.target); if (!h) return;
        if (e.relatedTarget instanceof Element && h.el.contains(e.relatedTarget)) return;
        markerOf(h.key)?.classList.remove('hover');
      });
      // 目印とナビは通常のリンク: 押すとその項目のページ（全画面）へ移動する（2026-11-21。以前は左半分の板に開いていた）
      // 旧 URL（/#about、/#message など、板を開く形式）で来たときは、その項目のページへ送る
      function redirectOldHash() { const m = location.hash.length > 1 ? markerOf(location.hash.slice(1)) : null; if (m) location.replace(m.href); }
      document.addEventListener('astro:page-load', redirectOldHash);
      // 最初のタウンビューでは「お知らせ」の目印にカーソルが載っている状態にしておく（直近 5 件を表示）
      function showDefaultSpot() {
        if (document.querySelector('.spot-info.on')) return;
        document.querySelector('.marker[data-spot="news"]')?.classList.add('hover');
        document.querySelector('.spot-info[data-for="news"]')?.classList.add('on');
      }
      document.addEventListener('astro:page-load', showDefaultSpot); showDefaultSpot();
      document.addEventListener('astro:before-swap', () => { if (d) { d.dispose(); d = null; } if (fx) { fx.dispose(); fx = null; } });
      document.addEventListener('astro:page-load', init);
      init();
      redirectOldHash();
    </script>
  </body>
</html>
